# Copy to .env and fill in. Never commit real values — .env* is gitignored.
#
# Where each key actually belongs:
#   Render dashboard  -> OPENROUTER_API_KEY, OPENROUTER_EMBED_KEY, ALLOWED_ORIGINS, SITE_URL
#   GitHub repo secrets -> OPENROUTER_API_KEY, OPENROUTER_EMBED_KEY, RAPIDAPI_KEY
#                          (the LinkedIn scrape runs in Actions, not on Render)
#   Vercel/Netlify build -> VITE_AGENT_API_URL
#
# See RENDER_DEPLOY.md for the full walkthrough.

# --- NVIDIA NIM (Direct High-Performance Inference - Recommended) ---
# Get API keys at https://build.nvidia.com
# Chat model:      nvidia/nemotron-3-nano-omni-30b-a3b-reasoning (fallback to nemotron-3-super-120b-a12b)
# Embedding model: nvidia/nemotron-3-embed-1b (2048 dimensions)
NVIDIA_API_KEY=
NVIDIA_EMBED_KEY=

# --- OpenRouter (Alternative / Fallback) ---
# Get keys at https://openrouter.ai/keys
# Keys are NOT model-scoped — one key works for both endpoints. The split exists
# so you can point embeddings at a second account and double the free 50/day quota.
# Chat model:      google/gemma-4-31b-it:free
# Embedding model: nvidia/nemotron-3-embed-1b:free
OPENROUTER_API_KEY=
OPENROUTER_EMBED_KEY=

# --- LinkedIn live sync ---
# Which adapter to use: rapidapi | dma | export | off
LINKEDIN_SOURCE=rapidapi
LINKEDIN_PROFILE_URL=https://www.linkedin.com/in/hetav-shah-26601722b/

# rapidapi: subscribe (free tier) to "Real-Time LinkedIn Scraper" at
# https://rapidapi.com/rockapis-rockapis-default/api/linkedin-api8
RAPIDAPI_KEY=
# Optional: a second free key on linkedin-data-api, which has its own 50-credit bucket
RAPIDAPI_KEY_FALLBACK=

# dma: LinkedIn Member Data Portability API. Free, official and better than
# scraping, but only available to members in the EEA + Switzerland.
# See server/lib/sources/linkedin/dma.js for the ~10-minute eligibility check.
LINKEDIN_DMA_TOKEN=

# --- Server ---
# Comma-separated origins allowed to POST /api/chat. Empty = allow all (dev only).
ALLOWED_ORIGINS=https://portfolio.vaquah.in
# Sent to OpenRouter as the attribution referer.
SITE_URL=https://portfolio.vaquah.in
PORT=3001

# --- Frontend ---
# Inlined into the client bundle at build time, so it is public by design.
# Empty = same-origin /api/chat.
VITE_AGENT_API_URL=
